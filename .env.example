# RCollab Environment Variables
# Copy to .env and fill in real values. NEVER commit .env files.
#
# Only VITE_* vars are exposed to the browser. Gateway/disbursement SECRETS are
# server-only and live in Supabase Edge Function secrets (see EDGE FUNCTION
# SECRETS at the bottom) — never put them here.

# ─── Backend (Lovable Cloud / Supabase) ──────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ─── App Config ──────────────────────────────────────
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0

# ─── Payments — safety (#11) ───────────────────────────────
# Dry-run by default: NO real charge unless this is exactly "false" AND the
# chosen provider below is enabled + configured.
VITE_PAYMENTS_DRY_RUN=true

# ─── Payments — providers (client/public side) ──────────────────
# JazzCash (PKR). Merchant id is non-secret; the integrity SALT is server-only.
VITE_JAZZCASH_ENABLED=false
VITE_JAZZCASH_MERCHANT_ID=
# Easypaisa (PKR). Store id is non-secret; the hash key is server-only.
VITE_EASYPAISA_ENABLED=false
VITE_EASYPAISA_STORE_ID=
# Stripe (USD / cards). Publishable key is safe for the client.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ─── Payouts — safety (#53/#55) ───────────────────────────
# Dry-run by default: NO real disbursement unless this is exactly "false".
VITE_PAYOUTS_DRY_RUN=true

# =================================================================
# EDGE FUNCTION SECRETS (server-only) — set via `supabase secrets set`,
# NOT in this file and NOT with a VITE_ prefix. Listed here for reference only.
# =================================================================
#
# Supabase (auto-provided in Edge runtime, listed for clarity):
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY      # settlement/payout/credit writes
#
# AI routing (#49):
#   LLM_DEFAULT_PROVIDER=ollama    # ollama | lovable
#   OLLAMA_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=qwen2.5:32b
#   ALLOW_LOVABLE_FALLBACK=true
#   LOVABLE_API_KEY=               # only for fallback / lovable mode
#   LOVABLE_MODEL=google/gemini-3-flash-preview
#
# AI credit enforcement (#51):
#   AI_CREDITS_ENFORCED=true
#
# Payment gateway secrets (#22) — used by payments-* + payments-settle:
#   JAZZCASH_MERCHANT_ID
#   JAZZCASH_PASSWORD
#   JAZZCASH_INTEGRITY_SALT
#   JAZZCASH_POST_URL
#   EASYPAISA_STORE_ID
#   EASYPAISA_HASH_KEY
#   EASYPAISA_POST_URL
#
# Payout disbursement secrets (#55) — used by payouts-disburse:
#   PAYOUTS_DRY_RUN=true
#   JAZZCASH_PAYOUT_URL
#   JAZZCASH_PAYOUT_KEY
#   EASYPAISA_PAYOUT_URL
#   EASYPAISA_PAYOUT_KEY
